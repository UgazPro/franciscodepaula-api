generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////

enum Currency {
  USD
  VES
}

enum AdjustmentType {
  BONUS
  DEDUCTION
}

//////////////////////////////////////////////////
// ROLE
//////////////////////////////////////////////////

model Role {
  id    Int    @id @default(autoincrement())
  role  String @unique

  users User[]
}

//////////////////////////////////////////////////
// PERSON
//////////////////////////////////////////////////

model Person {
  id                     Int @id @default(autoincrement())

  profilePhoto           String?
  firstNames             String
  lastNames              String
  identificationNumber   String @unique
  birthDate              DateTime
  gender                 String?

  user                   User?
  student                Student?
}

//////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////

model User {

  id Int @id @default(autoincrement())

  personId Int @unique
  roleId Int

  email String @unique
  password String
  phone String?

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields:[personId],references:[id])
  role Role @relation(fields:[roleId],references:[id])

  representative Representative?
  employee Employee?

  approvedWorkHours EmployeeWorkHour[]
}

//////////////////////////////////////////////////
// STUDENT
//////////////////////////////////////////////////

model Student {

 id Int @id @default(autoincrement())

 personId Int @unique

 birthCountry String?
 state String?
 parish String?
 previousSchool String?
 address String?

 status Boolean

 admissionDate DateTime?

 person Person @relation(fields:[personId],references:[id])

 sections StudentSection[]
 enrollments StudentEnrollment[]

 representatives StudentRepresentative[]

 grades GradeRecord[]
 reportCards ReportCard[]

 charges StudentCharge[]
}

//////////////////////////////////////////////////

model StudentSection {

 id Int @id @default(autoincrement())

 studentId Int
 sectionId Int

 enrollmentDate DateTime?

 status Boolean

 student Student @relation(fields:[studentId],references:[id])

 section Section @relation(fields:[sectionId],references:[id])

 @@unique([studentId,sectionId])

}

//////////////////////////////////////////////////

model Representative {

 id Int @id @default(autoincrement())

 userId Int @unique

 relationship String?
 occupation String?

 user User @relation(fields:[userId],references:[id])

 students StudentRepresentative[]

}

//////////////////////////////////////////////////

model StudentRepresentative {

 id Int @id @default(autoincrement())

 studentId Int
 representativeId Int

 student Student @relation(fields:[studentId],references:[id])

 representative Representative @relation(fields:[representativeId],references:[id])

 @@unique([studentId,representativeId])

}

//////////////////////////////////////////////////

model Employee {

 id Int @id @default(autoincrement())

 userId Int @unique

 baseHourRate Decimal? @db.Decimal(10,2)

 hireDate DateTime?

 user User @relation(fields:[userId],references:[id])

 assignments TeacherSubjectSection[]

 createdGrades GradeRecord[]

 workHours EmployeeWorkHour[]

 payrollRecords PayrollRecord[]

}

//////////////////////////////////////////////////

model SchoolYear {

 id Int @id @default(autoincrement())

 name String

 startDate DateTime
 endDate DateTime

 isActive Boolean?

 createdAt DateTime @default(now())

 periods Period[]

 sections Section[]

 enrollments StudentEnrollment[]

 reportCards ReportCard[]

 charges StudentCharge[]

}

//////////////////////////////////////////////////

model Period {

 id Int @id @default(autoincrement())

 schoolYearId Int

 period String

 startDate DateTime?
 endDate DateTime?

 schoolYear SchoolYear @relation(fields:[schoolYearId],references:[id])

 evaluations Evaluation[]

}

//////////////////////////////////////////////////

model HighSchoolLevel {

 id Int @id @default(autoincrement())

 level String

 sections Section[]

}

//////////////////////////////////////////////////

model Section {

 id Int @id @default(autoincrement())

 schoolYearId Int

 highSchoolLevelId Int

 section String

 schoolYear SchoolYear @relation(fields:[schoolYearId],references:[id])

 level HighSchoolLevel @relation(fields:[highSchoolLevelId],references:[id])

 students StudentSection[]

 enrollments StudentEnrollment[]

 assignments TeacherSubjectSection[]

 @@unique([schoolYearId,highSchoolLevelId,section])

}

//////////////////////////////////////////////////

model StudentEnrollment {

 id Int @id @default(autoincrement())

 studentId Int

 schoolYearId Int

 sectionId Int

 enrollmentDate DateTime?

 status Boolean?

 student Student @relation(fields:[studentId],references:[id])

 schoolYear SchoolYear @relation(fields:[schoolYearId],references:[id])

 section Section @relation(fields:[sectionId],references:[id])

}

//////////////////////////////////////////////////

model Subject {

 id Int @id @default(autoincrement())

 subject String

 code String?

 status Boolean?

 assignments TeacherSubjectSection[]

}

//////////////////////////////////////////////////

model TeacherSubjectSection {

 id Int @id @default(autoincrement())

 teacherId Int

 subjectId Int

 sectionId Int

 status Boolean?

 employee Employee @relation(fields:[teacherId],references:[id])

 subject Subject @relation(fields:[subjectId],references:[id])

 section Section @relation(fields:[sectionId],references:[id])

 evaluations Evaluation[]

}

//////////////////////////////////////////////////

model Evaluation {

 id Int @id @default(autoincrement())

 teacherSubjectSectionId Int

 periodId Int

 title String

 percentage Decimal @db.Decimal(5,2)

 dueDate DateTime?

 assignment TeacherSubjectSection @relation(fields:[teacherSubjectSectionId],references:[id])

 period Period @relation(fields:[periodId],references:[id])

 grades GradeRecord[]

}

//////////////////////////////////////////////////

model GradeRecord {

 id Int @id @default(autoincrement())

 studentId Int

 evaluationId Int

 createdBy Int?

 score Decimal? @db.Decimal(5,2)

 observations String?

 createdAt DateTime @default(now())

 updatedAt DateTime @updatedAt

 student Student @relation(fields:[studentId],references:[id])

 evaluation Evaluation @relation(fields:[evaluationId],references:[id])

 employee Employee? @relation(fields:[createdBy],references:[id])

}

//////////////////////////////////////////////////

model ReportCard {

 id Int @id @default(autoincrement())

 studentId Int

 academicPeriodId Int

 term Int

 average Decimal? @db.Decimal(5,2)

 observations String?

 generatedAt DateTime @default(now())

 student Student @relation(fields:[studentId],references:[id])

 schoolYear SchoolYear @relation(fields:[academicPeriodId],references:[id])

}

//////////////////////////////////////////////////
// FINANZAS
//////////////////////////////////////////////////

model ChargeType {

 id Int @id @default(autoincrement())

 name String @unique

 description String?

 charges StudentCharge[]

}

model StudentCharge {

 id Int @id @default(autoincrement())

 studentId Int

 paymentId Int?

 chargeTypeId Int

 schoolYearId Int?

 description String?

 createdAt DateTime @default(now())

 student Student @relation(fields:[studentId],references:[id])

 chargeType ChargeType @relation(fields:[chargeTypeId],references:[id])

 schoolYear SchoolYear? @relation(fields:[schoolYearId],references:[id])

 payment Payment? @relation(fields:[paymentId],references:[id])

}

model PaymentMethod {

 id Int @id @default(autoincrement())

 type String

 bank String?
 accountNumber String?

 identification String?

 email String?

 phone String?

 owner String?

 active Boolean @default(true)

 payments Payment[]

}

model Exchange {

 id Int @id @default(autoincrement())

 rate Decimal @db.Decimal(10,2)

 date DateTime

 payments Payment[]

}

model Payment {

 id Int @id @default(autoincrement())

 paymentMethodId Int

 exchangeId Int?

 totalAmount Decimal @db.Decimal(12,2)

 currency Currency

 paymentDate DateTime @default(now())

 reference String?

 payerName String?

 payerIdentification String?

 payerPhone String?

 status Boolean

 paymentMethod PaymentMethod @relation(fields:[paymentMethodId],references:[id])

 exchange Exchange? @relation(fields:[exchangeId],references:[id])

 charges StudentCharge[]

}

//////////////////////////////////////////////////
// NOMINA
//////////////////////////////////////////////////

model PayrollPeriod {

 id Int @id @default(autoincrement())

 month Int

 year Int

 startDate DateTime?

 endDate DateTime?

 status Boolean

 workHours EmployeeWorkHour[]

 payrolls PayrollRecord[]

 @@unique([month,year])

}

model EmployeeWorkHour {

 id Int @id @default(autoincrement())

 employeeId Int

 payrollPeriodId Int

 approvedBy Int?

 assignedHours Decimal @db.Decimal(8,2)

 observations String?

 createdAt DateTime @default(now())

 employee Employee @relation(fields:[employeeId],references:[id])

 approver User? @relation(fields:[approvedBy],references:[id])

 payrollPeriod PayrollPeriod @relation(fields:[payrollPeriodId],references:[id])

 @@unique([employeeId,payrollPeriodId])

}

model PayrollRecord {

 id Int @id @default(autoincrement())

 employeeId Int

 payrollPeriodId Int

 hourlyRate Decimal? @db.Decimal(10,2)

 workedHours Decimal? @db.Decimal(8,2)

 grossSalary Decimal? @db.Decimal(12,2)

 deductions Decimal @default(0) @db.Decimal(12,2)

 bonuses Decimal @default(0) @db.Decimal(12,2)

 netSalary Decimal? @db.Decimal(12,2)

 currency Currency

 paymentStatus Boolean

 paymentDate DateTime?

 generatedAt DateTime @default(now())

 employee Employee @relation(fields:[employeeId],references:[id])

 payrollPeriod PayrollPeriod @relation(fields:[payrollPeriodId],references:[id])

 adjustments PayrollAdjustment[]

 @@unique([employeeId,payrollPeriodId])

}

model PayrollAdjustment {

 id Int @id @default(autoincrement())

 payrollRecordId Int

 type AdjustmentType

 concept String

 amount Decimal @db.Decimal(10,2)

 payroll PayrollRecord @relation(fields:[payrollRecordId],references:[id])

}