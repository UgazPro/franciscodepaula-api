generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////

enum Currency {
  USD
  VES
}

enum AdjustmentType {
  BONUS
  DEDUCTION
}

//////////////////////////////////////////////////
// ROLE
//////////////////////////////////////////////////

model Role {
  id   Int    @id @default(autoincrement())
  role String @unique

  users User[]
}

//////////////////////////////////////////////////
// PERSON
//////////////////////////////////////////////////

model Person {
  id                     Int      @id @default(autoincrement())

  profilePhoto           String?
  firstNames             String
  lastNames              String
  identificationNumber   String   @unique
  birthDate              DateTime
  gender                 String?

  user                   User?
  student                Student?
}

//////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////

model User {
  id Int @id @default(autoincrement())

  personId Int @unique
  roleId   Int

  email    String @unique
  password String
  phone    String?

  status Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  representative Representative?
  employee       Employee?

  approvedWorkHours EmployeeWorkHour[]
}

//////////////////////////////////////////////////
// STUDENT
//////////////////////////////////////////////////

model Student {
  id Int @id @default(autoincrement())

  personId Int @unique

  birthCountry  String?
  state         String?
  municipality  String?
  parish        String?
  currentParish String?
  previousSchool String?
  address        String?

  status Boolean?

  admissionDate DateTime?

  person Person @relation(fields: [personId], references: [id])

  studentSections StudentSection[]
  enrollments     StudentEnrollment[]
  studentFees     StudentFee[]

  representatives StudentRepresentative[]

  gradeRecords GradeRecord[]
  reportCards ReportCard[]
}

//////////////////////////////////////////////////
// STUDENT SECTION
//////////////////////////////////////////////////

model StudentSection {
  id Int @id @default(autoincrement())

  studentId Int
  sectionId Int

  enrollmentDate DateTime?

  status Boolean?

  student Student @relation(fields: [studentId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  @@unique([studentId, sectionId])
}

//////////////////////////////////////////////////
// REPRESENTATIVE
//////////////////////////////////////////////////

model Representative {
  id Int @id @default(autoincrement())

  userId Int @unique

  relationship String?
  occupation   String?

  user User @relation(fields: [userId], references: [id])

  students StudentRepresentative[]
}

//////////////////////////////////////////////////
// STUDENT REPRESENTATIVE
//////////////////////////////////////////////////

model StudentRepresentative {
  id Int @id @default(autoincrement())

  studentId        Int
  representativeId Int

  student Student @relation(fields: [studentId], references: [id])

  representative Representative @relation(fields: [representativeId], references: [id])

  @@unique([studentId, representativeId])
}

//////////////////////////////////////////////////
// EMPLOYEE
//////////////////////////////////////////////////

model Employee {
  id Int @id @default(autoincrement())

  userId Int @unique

  baseHourRate Decimal? @db.Decimal(10,2)

  hireDate DateTime?

  user User @relation(fields: [userId], references: [id])

  assignments TeacherSubjectSection[]

  createdGrades GradeRecord[]

  workHours EmployeeWorkHour[]

  payrollRecords PayrollRecord[]
}

//////////////////////////////////////////////////
// SCHOOL YEAR
//////////////////////////////////////////////////

model SchoolYear {
  id Int @id @default(autoincrement())

  name String

  startDate DateTime
  endDate   DateTime

  isActive Boolean?

  createdAt DateTime @default(now())

  periods     Period[]
  sections    Section[]
  enrollments StudentEnrollment[]

  reportCards ReportCard[]

  fees Fee[]
}

//////////////////////////////////////////////////
// PERIOD
//////////////////////////////////////////////////

model Period {
  id Int @id @default(autoincrement())

  schoolYearId Int

  period String

  startDate DateTime?
  endDate   DateTime?

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])

  evaluations Evaluation[]
}

//////////////////////////////////////////////////
// HIGH SCHOOL LEVEL
//////////////////////////////////////////////////

model HighSchoolLevel {
  id Int @id @default(autoincrement())

  level String

  sections Section[]
}

//////////////////////////////////////////////////
// SECTION
//////////////////////////////////////////////////

model Section {
  id Int @id @default(autoincrement())

  schoolYearId      Int
  highSchoolLevelId Int

  section String

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])

  highSchoolLevel HighSchoolLevel @relation(fields: [highSchoolLevelId], references: [id])

  students    StudentSection[]
  enrollments StudentEnrollment[]

  assignments TeacherSubjectSection[]
}

//////////////////////////////////////////////////
// STUDENT ENROLLMENT
//////////////////////////////////////////////////

model StudentEnrollment {
  id Int @id @default(autoincrement())

  studentId    Int
  schoolYearId Int
  sectionId    Int

  referenceId Int?

  enrollmentDate DateTime?

  status Boolean?

  student Student @relation(fields: [studentId], references: [id])

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])

  section Section @relation(fields: [sectionId], references: [id])

  paymentReference PaymentReference? @relation(fields: [referenceId], references: [id])
}

//////////////////////////////////////////////////
// SUBJECT
//////////////////////////////////////////////////

model Subject {
  id Int @id @default(autoincrement())

  subject String

  code String?

  status Boolean?

  assignments TeacherSubjectSection[]
}

//////////////////////////////////////////////////
// TEACHER SUBJECT SECTION
//////////////////////////////////////////////////

model TeacherSubjectSection {
  id Int @id @default(autoincrement())

  teacherId Int
  subjectId Int
  sectionId Int

  status Boolean?

  employee Employee @relation(fields: [teacherId], references: [id])

  subject Subject @relation(fields: [subjectId], references: [id])

  section Section @relation(fields: [sectionId], references: [id])

  evaluations Evaluation[]

  @@unique([teacherId, subjectId, sectionId])
}

//////////////////////////////////////////////////
// EVALUATION
//////////////////////////////////////////////////

model Evaluation {
  id Int @id @default(autoincrement())

  teacherSubjectSectionId Int
  periodId                Int

  title String

  percentage Decimal @db.Decimal(5,2)

  dueDate DateTime?

  teacherSubjectSection TeacherSubjectSection @relation(fields: [teacherSubjectSectionId], references: [id])

  period Period @relation(fields: [periodId], references: [id])

  grades GradeRecord[]
}

//////////////////////////////////////////////////
// GRADE RECORD
//////////////////////////////////////////////////

model GradeRecord {
  id Int @id @default(autoincrement())

  studentId    Int
  evaluationId Int

  score Decimal? @db.Decimal(5,2)

  observations String?

  createdBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])

  evaluation Evaluation @relation(fields: [evaluationId], references: [id])

  employee Employee? @relation(fields: [createdBy], references: [id])

  @@unique([studentId, evaluationId])
}

//////////////////////////////////////////////////
// REPORT CARD
//////////////////////////////////////////////////

model ReportCard {
  id Int @id @default(autoincrement())

  studentId Int

  academicPeriodId Int

  term Int

  average Decimal? @db.Decimal(5,2)

  observations String?

  generatedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  schoolYear SchoolYear @relation(fields: [academicPeriodId], references: [id])

  @@unique([studentId, academicPeriodId, term])
}

//////////////////////////////////////////////////
// PAYMENT METHODS
//////////////////////////////////////////////////

model PaymentMethod {
  id Int @id @default(autoincrement())

  type String

  bank String?

  accountNumber String?

  identification String?

  email String?

  phone String?

  owner String?

  active Boolean @default(true)

  payments Payment[]
}

//////////////////////////////////////////////////
// FEE
//////////////////////////////////////////////////

model Fee {
  id Int @id @default(autoincrement())

  name String

  schoolYearId Int

  value Int

  createdAt DateTime

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])

  studentFees StudentFee[]
}

//////////////////////////////////////////////////
// STUDENT FEE
//////////////////////////////////////////////////

model StudentFee {
  id Int @id @default(autoincrement())

  studentId Int

  feeId Int

  status Boolean?

  student Student @relation(fields: [studentId], references: [id])

  fee Fee @relation(fields: [feeId], references: [id])

  paymentReferences PaymentReference[]

  @@unique([studentId, feeId])
}

//////////////////////////////////////////////////
// PAYMENT REFERENCE
//////////////////////////////////////////////////

model PaymentReference {
  id Int @id @default(autoincrement())

  studentFeeId Int

  paymentId Int

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id])

  payment Payment @relation(fields: [paymentId], references: [id])

  enrollments StudentEnrollment[]
}

//////////////////////////////////////////////////
// EXCHANGE
//////////////////////////////////////////////////

model Exchange {
  id Int @id @default(autoincrement())

  rate Decimal @db.Decimal(10,2)

  date DateTime

  payments Payment[]
}

//////////////////////////////////////////////////
// PAYMENTS
//////////////////////////////////////////////////

model Payment {
  id Int @id @default(autoincrement())

  paymentMethodId Int

  totalAmount Decimal @db.Decimal(12,2)

  currency Currency

  paymentDate DateTime @default(now())

  reference String?

  payerName String?

  payerIdentification String?

  payerPhone String?

  exchangeId Int?

  description String?

  status Boolean?

  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  exchange Exchange? @relation(fields: [exchangeId], references: [id])

  paymentReferences PaymentReference[]
}

//////////////////////////////////////////////////
// PAYROLL PERIODS
//////////////////////////////////////////////////

model PayrollPeriod {
  id Int @id @default(autoincrement())

  month Int

  year Int

  startDate DateTime?

  endDate DateTime?

  status Boolean?

  workHours EmployeeWorkHour[]

  payrollRecords PayrollRecord[]

  @@unique([month, year])
}

//////////////////////////////////////////////////
// EMPLOYEE WORK HOURS
//////////////////////////////////////////////////

model EmployeeWorkHour {
  id Int @id @default(autoincrement())

  employeeId Int

  payrollPeriodId Int

  assignedHours Decimal @db.Decimal(8,2)

  approvedBy Int?

  observations String?

  createdAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  approver User? @relation(fields: [approvedBy], references: [id])

  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])

  @@unique([employeeId, payrollPeriodId])
}

//////////////////////////////////////////////////
// PAYROLL RECORDS
//////////////////////////////////////////////////

model PayrollRecord {
  id Int @id @default(autoincrement())

  employeeId Int

  payrollPeriodId Int

  hourlyRate Decimal? @db.Decimal(10,2)

  workedHours Decimal? @db.Decimal(8,2)

  grossSalary Decimal? @db.Decimal(12,2)

  deductions Decimal? @default(0) @db.Decimal(12,2)

  bonuses Decimal? @default(0) @db.Decimal(12,2)

  netSalary Decimal? @db.Decimal(12,2)

  currency String? @default("USD")

  paymentStatus String? @default("pending")

  paymentDate DateTime?

  generatedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])

  adjustments PayrollAdjustment[]

  @@unique([employeeId, payrollPeriodId])
}

//////////////////////////////////////////////////
// PAYROLL ADJUSTMENTS
//////////////////////////////////////////////////

model PayrollAdjustment {
  id Int @id @default(autoincrement())

  payrollRecordId Int

  type AdjustmentType

  concept String

  amount Decimal @db.Decimal(10,2)

  payrollRecord PayrollRecord @relation(fields: [payrollRecordId], references: [id])
}