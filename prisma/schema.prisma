generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////
// ROLES
//////////////////////////////////////////////////

model Role {
  id    Int    @id @default(autoincrement())
  role  String @unique

  users User[]
}

//////////////////////////////////////////////////
// PEOPLE
//////////////////////////////////////////////////

model Person {
  id                   Int @id @default(autoincrement())

  profilePhoto         String?
  firstNames           String
  lastNames            String
  identificationNumber String @unique
  birthDate            DateTime
  gender               String?

  user    User?
  student Student?
}

//////////////////////////////////////////////////
// USERS
//////////////////////////////////////////////////

model User {
  id Int @id @default(autoincrement())

  personId Int @unique
  roleId   Int

  email    String @unique
  password String
  phone    String?

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  representative Representative?
  employee Employee?
}

//////////////////////////////////////////////////
// STUDENTS
//////////////////////////////////////////////////

model Student {
  id Int @id @default(autoincrement())

  personId Int @unique

  birthCountry   String?
  state          String?
  parish         String?
  previousSchool String?
  address        String?

  status Boolean

  admissionDate DateTime?

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  sections StudentSection[]
  enrollments StudentEnrollment[]

  representatives StudentRepresentative[]

  grades GradeRecord[]
  reportCards ReportCard[]
}

//////////////////////////////////////////////////
// STUDENT SECTION
//////////////////////////////////////////////////

model StudentSection {
  id Int @id @default(autoincrement())

  studentId Int
  sectionId Int

  enrollmentDate DateTime?

  status String @default("active")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([studentId, sectionId])
}

//////////////////////////////////////////////////
// REPRESENTATIVE
//////////////////////////////////////////////////

model Representative {
  id Int @id @default(autoincrement())

  userId Int @unique

  relationship String?
  occupation String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  students StudentRepresentative[]
}

//////////////////////////////////////////////////
// STUDENT REPRESENTATIVE
//////////////////////////////////////////////////

model StudentRepresentative {
  id Int @id @default(autoincrement())

  studentId Int
  representativeId Int

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  representative Representative @relation(fields:[representativeId],references:[id],onDelete:Cascade)

  @@unique([studentId, representativeId])
}

//////////////////////////////////////////////////
// EMPLOYEES
//////////////////////////////////////////////////

model Employee {
  id Int @id @default(autoincrement())

  userId Int @unique

  salary Decimal? @db.Decimal(10,2)

  hireDate DateTime?

  user User @relation(fields:[userId],references:[id],onDelete:Cascade)

  assignments TeacherSubjectSection[]

  createdGrades GradeRecord[]
}

//////////////////////////////////////////////////
// SCHOOL YEAR
//////////////////////////////////////////////////

model SchoolYear {
  id Int @id @default(autoincrement())

  name String

  startDate DateTime
  endDate DateTime

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  periods Period[]

  sections Section[]

  enrollments StudentEnrollment[]

  reportCards ReportCard[]
}

//////////////////////////////////////////////////
// PERIODS
//////////////////////////////////////////////////

model Period {

  id Int @id @default(autoincrement())

  schoolYearId Int

  period String

  startDate DateTime?

  endDate DateTime?

  schoolYear SchoolYear @relation(fields:[schoolYearId],references:[id],onDelete:Cascade)

  evaluations Evaluation[]
}

//////////////////////////////////////////////////
// LEVELS
//////////////////////////////////////////////////

model HighSchoolLevel {

 id Int @id @default(autoincrement())

 level String

 sections Section[]
}

//////////////////////////////////////////////////
// SECTION
//////////////////////////////////////////////////

model Section {

 id Int @id @default(autoincrement())

 schoolYearId Int

 highSchoolLevelId Int

 section String

 schoolYear SchoolYear @relation(fields:[schoolYearId],references:[id])

 level HighSchoolLevel @relation(fields:[highSchoolLevelId],references:[id])

 students StudentSection[]

 enrollments StudentEnrollment[]

 teacherAssignments TeacherSubjectSection[]

 @@unique([schoolYearId,highSchoolLevelId,section])
}

//////////////////////////////////////////////////
// ENROLLMENTS
//////////////////////////////////////////////////

model StudentEnrollment {

 id Int @id @default(autoincrement())

 studentId Int

 schoolYearId Int

 sectionId Int

 enrollmentDate DateTime?

 status Boolean @default(true)

 student Student @relation(fields:[studentId],references:[id])

 schoolYear SchoolYear @relation(fields:[schoolYearId],references:[id])

 section Section @relation(fields:[sectionId],references:[id])
}

//////////////////////////////////////////////////
// SUBJECTS
//////////////////////////////////////////////////

model Subject {

 id Int @id @default(autoincrement())

 subject String

 code String?

 status Boolean @default(true)

 assignments TeacherSubjectSection[]
}

//////////////////////////////////////////////////
// TEACHER SUBJECT SECTION
//////////////////////////////////////////////////

model TeacherSubjectSection {

 id Int @id @default(autoincrement())

 teacherId Int

 subjectId Int

 sectionId Int

 status Boolean @default(true)

 employee Employee @relation(fields:[teacherId],references:[id])

 subject Subject @relation(fields:[subjectId],references:[id])

 section Section @relation(fields:[sectionId],references:[id])

 evaluations Evaluation[]

 @@unique([teacherId,subjectId,sectionId])
}

//////////////////////////////////////////////////
// EVALUATIONS
//////////////////////////////////////////////////

model Evaluation {

 id Int @id @default(autoincrement())

 teacherSubjectSectionId Int

 periodId Int

 title String

 percentage Decimal @db.Decimal(5,2)

 dueDate DateTime?

 assignment TeacherSubjectSection @relation(fields:[teacherSubjectSectionId],references:[id])

 period Period @relation(fields:[periodId],references:[id])

 grades GradeRecord[]
}

//////////////////////////////////////////////////
// GRADE RECORDS
//////////////////////////////////////////////////

model GradeRecord {

 id Int @id @default(autoincrement())

 studentId Int

 evaluationId Int

 score Decimal? @db.Decimal(5,2)

 observations String?

 createdBy Int?

 createdAt DateTime @default(now())

 updatedAt DateTime @updatedAt

 student Student @relation(fields:[studentId],references:[id])

 evaluation Evaluation @relation(fields:[evaluationId],references:[id])

 employee Employee? @relation(fields:[createdBy],references:[id])

 @@unique([studentId,evaluationId])
}

//////////////////////////////////////////////////
// REPORT CARDS
//////////////////////////////////////////////////

model ReportCard {

 id Int @id @default(autoincrement())

 studentId Int

 academicPeriodId Int

 term Int

 average Decimal? @db.Decimal(5,2)

 observations String?

 generatedAt DateTime @default(now())

 student Student @relation(fields:[studentId],references:[id])

 schoolYear SchoolYear @relation(fields:[academicPeriodId],references:[id])

 @@unique([studentId,academicPeriodId,term])
}