generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////

enum Currency {
  USD
  VES
}

enum AdjustmentType {
  BONUS
  DEDUCTION
}

//////////////////////////////////////////////////
// ROLE
//////////////////////////////////////////////////

model Role {
  id   Int    @id @default(autoincrement())
  role String @unique

  userRoles UserRole[]
}

//////////////////////////////////////////////////
// USER ROLE
//////////////////////////////////////////////////

model UserRole {
  id     Int @id @default(autoincrement())
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

//////////////////////////////////////////////////
// PERSON
//////////////////////////////////////////////////

model Person {
  id Int @id @default(autoincrement())

  profilePhoto         String?
  firstNames           String
  lastNames            String
  identificationNumber String   @unique
  birthDate            DateTime
  gender               String?

  user    User?
  student Student?
}

//////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////

model User {
  id Int @id @default(autoincrement())

  personId Int @unique

  email    String  @unique
  password String
  phone    String?

  status Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id])

  representative Representative?
  employee       Employee?

  userRoles UserRole[]

  approvedWorkHours EmployeeWorkHour[]
}

//////////////////////////////////////////////////
// STUDENT
//////////////////////////////////////////////////

model Student {
  id Int @id @default(autoincrement())

  personId Int @unique

  birthCountry   String?
  state          String?
  municipality   String?
  parish         String?
  currentParish  String?
  previousSchool String?
  address        String?

  status Boolean?

  admissionDate DateTime?

  person Person @relation(fields: [personId], references: [id])

  enrollments StudentEnrollment[]
  studentFees StudentFee[]

  representatives StudentRepresentative[]

  gradeRecords GradeRecord[]
  reportCards  ReportCard[]
}

//////////////////////////////////////////////////
// REPRESENTATIVE
//////////////////////////////////////////////////

model Representative {
  id Int @id @default(autoincrement())

  userId Int @unique

  occupation String?

  user User @relation(fields: [userId], references: [id])

  students StudentRepresentative[]
}

//////////////////////////////////////////////////
// STUDENT REPRESENTATIVE
//////////////////////////////////////////////////

model StudentRepresentative {
  id Int @id @default(autoincrement())

  studentId        Int
  representativeId Int

  relationship String?
  isPrimary    Boolean? @default(false)

  student Student @relation(fields: [studentId], references: [id])

  representative Representative @relation(fields: [representativeId], references: [id])

  @@unique([studentId, representativeId])
}

//////////////////////////////////////////////////
// EMPLOYEE
//////////////////////////////////////////////////

model Employee {
  id Int @id @default(autoincrement())

  userId Int @unique

  baseHourRate Decimal? @db.Decimal(10, 2)

  hireDate DateTime?

  user User @relation(fields: [userId], references: [id])

  teachingGroups TeachingGroup[]

  createdGrades GradeRecord[]

  workHours EmployeeWorkHour[]

  payrollRecords PayrollRecord[]
}

//////////////////////////////////////////////////
// SCHOOL YEAR
//////////////////////////////////////////////////

model SchoolYear {
  id Int @id @default(autoincrement())

  name String

  startDate DateTime
  endDate   DateTime

  isActive Boolean?

  createdAt DateTime @default(now())

  periods     Period[]
  sections    Section[]
  enrollments StudentEnrollment[]

  teachingGroups TeachingGroup[]

  fees Fee[]
}

//////////////////////////////////////////////////
// PERIOD
//////////////////////////////////////////////////

model Period {
  id Int @id @default(autoincrement())

  schoolYearId Int

  period String

  startDate DateTime?
  endDate   DateTime?

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])

  evaluations Evaluation[]

  reportCards ReportCard[]
}

//////////////////////////////////////////////////
// HIGH SCHOOL LEVEL
//////////////////////////////////////////////////

model HighSchoolLevel {
  id Int @id @default(autoincrement())

  level String

  sections      Section[]
  levelSubjects LevelSubject[]
}

//////////////////////////////////////////////////
// SECTION
//////////////////////////////////////////////////

model Section {
  id Int @id @default(autoincrement())

  schoolYearId      Int
  highSchoolLevelId Int

  section String

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])

  highSchoolLevel HighSchoolLevel @relation(fields: [highSchoolLevelId], references: [id])

  enrollments StudentEnrollment[]

  teachingGroups TeachingGroup[]

  @@unique([schoolYearId, highSchoolLevelId, section])
}

//////////////////////////////////////////////////
// STUDENT ENROLLMENT
//////////////////////////////////////////////////

model StudentEnrollment {
  id Int @id @default(autoincrement())

  studentId    Int
  schoolYearId Int
  sectionId    Int

  enrollmentDate DateTime?

  paymentReferenceId Int? @unique

  status Boolean?

  student Student @relation(fields: [studentId], references: [id])

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])

  section Section @relation(fields: [sectionId], references: [id])

  studentFee StudentFee? @relation(fields: [paymentReferenceId], references: [id])

  studentTeachingGroups StudentTeachingGroup[]
}

//////////////////////////////////////////////////
// SUBJECT
//////////////////////////////////////////////////

model Subject {
  id Int @id @default(autoincrement())

  subject String

  code String?

  status Boolean?

  levelSubjects LevelSubject[]
}

//////////////////////////////////////////////////
// LEVEL SUBJECT
//////////////////////////////////////////////////

model LevelSubject {
  id                Int             @id @default(autoincrement())
  highSchoolLevelId Int
  subjectId         Int

  highSchoolLevel HighSchoolLevel @relation(fields: [highSchoolLevelId], references: [id])
  subject         Subject         @relation(fields: [subjectId], references: [id])

  @@unique([highSchoolLevelId, subjectId])
  teachingGroups TeachingGroup[]
}

//////////////////////////////////////////////////
// TEACHING GROUP
//////////////////////////////////////////////////

model TeachingGroup {
  id              Int      @id @default(autoincrement())
  teacherId       Int
  levelSubjectId  Int
  schoolYearId    Int
  sectionId       Int?
  groupName       String?
  isSpecialGroup  Boolean  @default(false)
  assignedAt      DateTime @default(now())
  status          Boolean?

  employee    Employee    @relation(fields: [teacherId], references: [id])
  levelSubject LevelSubject @relation(fields:[levelSubjectId], references:[id])
  schoolYear  SchoolYear  @relation(fields: [schoolYearId], references: [id])
  section     Section?    @relation(fields: [sectionId], references: [id])

  evaluations   Evaluation[]
  reportCards   ReportCard[]
  studentGroups StudentTeachingGroup[]

  @@unique([teacherId, levelSubjectId, schoolYearId, sectionId, groupName])
}

//////////////////////////////////////////////////
// STUDENT TEACHING GROUP
//////////////////////////////////////////////////

model StudentTeachingGroup {
  id                  Int      @id @default(autoincrement())
  studentEnrollmentId Int
  teachingGroupId     Int
  joinedAt            DateTime @default(now())

  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id])
  teachingGroup     TeachingGroup     @relation(fields: [teachingGroupId], references: [id])

  @@unique([studentEnrollmentId, teachingGroupId])
}

//////////////////////////////////////////////////
// EVALUATION
//////////////////////////////////////////////////

model EvaluationType {
  id Int @id @default(autoincrement())

  evaluationType String

  evaluations Evaluation[]
}

model Evaluation {
  id Int @id @default(autoincrement())

  teachingGroupId Int
  periodId        Int
  evaluationTypeId Int

  topic String

  objectives String?

  percentage Decimal @db.Decimal(5, 2)

  dueDate DateTime?

  createdAt DateTime @default(now())

  teachingGroup TeachingGroup @relation(fields: [teachingGroupId], references: [id])

  period Period @relation(fields: [periodId], references: [id])

  evaluationType EvaluationType @relation(fields: [evaluationTypeId], references: [id])

  grades GradeRecord[]
}

//////////////////////////////////////////////////
// GRADE RECORD
//////////////////////////////////////////////////

model GradeRecord {
  id Int @id @default(autoincrement())

  studentId    Int
  evaluationId Int

  score Decimal? @db.Decimal(5, 2)

  observations String?

  createdBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])

  evaluation Evaluation @relation(fields: [evaluationId], references: [id])

  employee Employee? @relation(fields: [createdBy], references: [id])

  @@unique([studentId, evaluationId])
}

//////////////////////////////////////////////////
// REPORT CARD
//////////////////////////////////////////////////

model ReportCard {
  id Int @id @default(autoincrement())

  studentId Int

  teachingGroupId Int

  periodId Int

  average Decimal? @db.Decimal(5, 2)

  observations String?

  generatedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  teachingGroup TeachingGroup @relation(fields: [teachingGroupId], references: [id])

  period Period @relation(fields:[periodId], references:[id])

  @@unique([studentId])
}

//////////////////////////////////////////////////
// LOCATION
//////////////////////////////////////////////////

model Country {
  id   Int    @id @default(autoincrement())
  name String @unique

  states State[]
}

model State {
  id        Int    @id @default(autoincrement())
  countryId Int
  name      String

  country        Country        @relation(fields: [countryId], references: [id])
  municipalities Municipality[]
}

model Municipality {
  id      Int    @id @default(autoincrement())
  stateId Int
  name    String

  state    State    @relation(fields: [stateId], references: [id])
  parishes Parish[]
}

model Parish {
  id             Int    @id @default(autoincrement())
  municipalityId Int
  name           String

  municipality Municipality @relation(fields: [municipalityId], references: [id])
}

//////////////////////////////////////////////////
// PAYMENT METHODS
//////////////////////////////////////////////////

model PaymentType {
  id      Int      @id @default(autoincrement())
  type    String
  currency Currency

  methods PaymentMethod[]
}

model PaymentMethod {
  id Int @id @default(autoincrement())

  paymentTypeId Int

  bank String?

  accountNumber String?

  identification String?

  email String?

  phone String?

  owner String?

  active Boolean @default(true)

  paymentType PaymentType @relation(fields: [paymentTypeId], references: [id])

  payments Payment[]
}

//////////////////////////////////////////////////
// FEE
//////////////////////////////////////////////////

model Fee {
  id Int @id @default(autoincrement())

  name String

  schoolYearId Int

  value Decimal @db.Decimal(10,2)

  createdAt DateTime

  startAt DateTime

  endAt DateTime

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])

  studentFees StudentFee[]
}

//////////////////////////////////////////////////
// STUDENT FEE
//////////////////////////////////////////////////

model StudentFee {
  id Int @id @default(autoincrement())

  studentId Int

  feeId Int

  paymentId Int

  status Boolean?

  student Student @relation(fields: [studentId], references: [id])

  fee Fee @relation(fields: [feeId], references: [id])

  payment Payment @relation(fields: [paymentId], references: [id])

  studentEnrollment StudentEnrollment?
}

//////////////////////////////////////////////////
// EXCHANGE
//////////////////////////////////////////////////

model Exchange {
  id Int @id @default(autoincrement())

  rate Decimal @db.Decimal(10, 2)

  date DateTime

  payments Payment[]
}

//////////////////////////////////////////////////
// PAYMENTS
//////////////////////////////////////////////////

model Payment {
  id Int @id @default(autoincrement())

  paymentMethodId Int

  totalAmount Decimal @db.Decimal(12, 2)

  currency Currency

  paymentDate DateTime @default(now())

  reference String?

  payerName String?

  payerIdentification String?

  payerPhone String?

  exchangeId Int?

  description String?

  status Boolean?

  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  exchange Exchange? @relation(fields: [exchangeId], references: [id])

  studentFees StudentFee[]
}

//////////////////////////////////////////////////
// PAYROLL PERIODS
//////////////////////////////////////////////////

model PayrollPeriod {
  id Int @id @default(autoincrement())

  month Int

  year Int

  startDate DateTime?

  endDate DateTime?

  status Boolean?

  workHours EmployeeWorkHour[]

  payrollRecords PayrollRecord[]

  @@unique([month, year])
}

//////////////////////////////////////////////////
// EMPLOYEE WORK HOURS
//////////////////////////////////////////////////

model EmployeeWorkHour {
  id Int @id @default(autoincrement())

  employeeId Int

  payrollPeriodId Int

  assignedHours Decimal @db.Decimal(8, 2)

  approvedBy Int?

  observations String?

  createdAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  approver User? @relation(fields: [approvedBy], references: [id])

  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])

  @@unique([employeeId, payrollPeriodId])
}

//////////////////////////////////////////////////
// PAYROLL RECORDS
//////////////////////////////////////////////////

model PayrollRecord {
  id Int @id @default(autoincrement())

  employeeId Int

  payrollPeriodId Int

  hourlyRate Decimal? @db.Decimal(10, 2)

  workedHours Decimal? @db.Decimal(8, 2)

  grossSalary Decimal? @db.Decimal(12, 2)

  deductions Decimal? @default(0) @db.Decimal(12, 2)

  bonuses Decimal? @default(0) @db.Decimal(12, 2)

  netSalary Decimal? @db.Decimal(12, 2)

  currency String? @default("USD")

  paymentStatus String? @default("pending")

  paymentDate DateTime?

  generatedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])

  adjustments PayrollAdjustment[]

  @@unique([employeeId, payrollPeriodId])
}

//////////////////////////////////////////////////
// PAYROLL ADJUSTMENTS
//////////////////////////////////////////////////

model PayrollAdjustment {
  id Int @id @default(autoincrement())

  payrollRecordId Int

  type AdjustmentType

  concept String

  amount Decimal @db.Decimal(10, 2)

  payrollRecord PayrollRecord @relation(fields: [payrollRecordId], references: [id])
}
