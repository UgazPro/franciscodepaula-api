generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////
// ROLES
//////////////////////////////////////////////////
model Role {
  id   Int    @id @default(autoincrement())
  role String @unique

  users User[]
}

//////////////////////////////////////////////////
// PEOPLE (BASE ENTITY)
//////////////////////////////////////////////////
model Person {
  id                   Int      @id @default(autoincrement())
  profilePhoto         String?
  firstNames           String
  lastNames            String
  identificationNumber String   @unique
  birthDate            DateTime
  gender               String?

  user    User?
  student Student?
}

//////////////////////////////////////////////////
// USERS (AUTH)
//////////////////////////////////////////////////
model User {
  id       Int @id @default(autoincrement())
  personId Int @unique
  roleId   Int

  email     String   @unique
  password  String
  phone     String?
  status    Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  representative Representative?
  employee       Employee?

  incidentsReported Incident[]
  formatsUploaded   Format[]
}

//////////////////////////////////////////////////
// STUDENTS
//////////////////////////////////////////////////
model Student {
  id       Int @id @default(autoincrement())
  personId Int @unique

  birthCountry   String?
  state          String?
  parish         String?
  previousSchool String?
  address        String?
  status         Boolean?    
  admissionDate  DateTime?
  sectionId      Int?

  person  Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  section Section? @relation(fields: [sectionId], references: [id])

  representatives StudentRepresentative[]
  grades          GradeRecord[]
  reportCards     ReportCard[]
  payments        Payment[]
  attendance      StudentAttendance[]
  incidents       Incident[]

  @@index([sectionId])
}

//////////////////////////////////////////////////
// REPRESENTATIVES
//////////////////////////////////////////////////
model Representative {
  id     Int @id @default(autoincrement())
  userId Int @unique

  relationship String?
  occupation   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  students StudentRepresentative[]
}

//////////////////////////////////////////////////
// EMPLOYEES
//////////////////////////////////////////////////
model Employee {
  id     Int @id @default(autoincrement())
  userId Int @unique

  salary   Decimal?
  hireDate DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  teacher  Teacher?
  payrolls PayrollRecord[]
}

//////////////////////////////////////////////////
// TEACHERS (SPECIALIZATION OF EMPLOYEE)
//////////////////////////////////////////////////
model Teacher {
  id         Int @id @default(autoincrement())
  employeeId Int @unique

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  subjects     TeacherSubjectSection[]
  attendance   TeacherAttendance[]
  gradeRecords GradeRecord[]
  plannings    Planning[]
}

//////////////////////////////////////////////////
// ACADEMIC STRUCTURE
//////////////////////////////////////////////////
model AcademicPeriod {
  id        Int      @id @default(autoincrement())
  name      String
  startDate DateTime
  endDate   DateTime
  status    String   @default("active")

  sections    Section[]
  evaluations Evaluation[]
  reportCards ReportCard[]
}

model Grade {
  id    Int    @id @default(autoincrement())
  grade String

  sections Section[]
}

model Section {
  id               Int    @id @default(autoincrement())
  section          String
  gradeId          Int
  academicPeriodId Int

  grade          Grade          @relation(fields: [gradeId], references: [id])
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id])

  students           Student[]
  teacherAssignments TeacherSubjectSection[]
  plannings          Planning[]
}

//////////////////////////////////////////////////
// STUDENT - REPRESENTATIVE (M:N)
//////////////////////////////////////////////////
model StudentRepresentative {
  studentId        Int
  representativeId Int

  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  representative Representative @relation(fields: [representativeId], references: [id], onDelete: Cascade)

  @@id([studentId, representativeId])
}

//////////////////////////////////////////////////
// SUBJECTS
//////////////////////////////////////////////////
model Subject {
  id      Int    @id @default(autoincrement())
  subject String

  evaluations Evaluation[]
  teachers    TeacherSubjectSection[]
  attendance  StudentAttendance[]
  plannings   Planning[]
}

//////////////////////////////////////////////////
// TEACHER - SUBJECT - SECTION
//////////////////////////////////////////////////
model TeacherSubjectSection {
  id        Int @id @default(autoincrement())
  teacherId Int
  subjectId Int
  sectionId Int

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, sectionId])
}

//////////////////////////////////////////////////
// EVALUATIONS & GRADES
//////////////////////////////////////////////////
model Evaluation {
  id               Int     @id @default(autoincrement())
  name             String
  percentage       Decimal
  subjectId        Int
  academicPeriodId Int
  term             Int

  subject Subject        @relation(fields: [subjectId], references: [id])
  period  AcademicPeriod @relation(fields: [academicPeriodId], references: [id])

  grades GradeRecord[]
}

model GradeRecord {
  id           Int      @id @default(autoincrement())
  studentId    Int
  evaluationId Int
  score        Decimal?
  observations String?
  createdBy    Int?
  createdAt    DateTime @default(now())

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  teacher    Teacher?   @relation(fields: [createdBy], references: [id])

  @@unique([studentId, evaluationId])
}

//////////////////////////////////////////////////
// REPORT CARDS
//////////////////////////////////////////////////
model ReportCard {
  id               Int      @id @default(autoincrement())
  studentId        Int
  academicPeriodId Int
  term             Int
  average          Decimal?
  observations     String?
  generatedAt      DateTime @default(now())

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  period  AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicPeriodId, term])
}

//////////////////////////////////////////////////
// PAYMENTS & INVOICES
//////////////////////////////////////////////////
model Payment {
  id            Int      @id @default(autoincrement())
  studentId     Int
  amount        Decimal
  paymentDate   DateTime
  paymentMethod String?
  status        String   @default("completed")
  description   String?

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoice Invoice?
}

model Invoice {
  id            Int      @id @default(autoincrement())
  paymentId     Int      @unique
  invoiceNumber String   @unique
  issueDate     DateTime
  totalAmount   Decimal
  status        String   @default("issued")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////
// PAYROLL
//////////////////////////////////////////////////
model PayrollRecord {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  period      String
  baseSalary  Decimal
  deductions  Decimal   @default(0)
  bonuses     Decimal   @default(0)
  netSalary   Decimal?
  paymentDate DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////
// ATTENDANCE
//////////////////////////////////////////////////
model StudentAttendance {
  id           Int      @id @default(autoincrement())
  studentId    Int
  date         DateTime
  attendance   Boolean
  observations String?
  subjectId    Int?

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id])

  @@unique([studentId, date])
}

model TeacherAttendance {
  id           Int      @id @default(autoincrement())
  teacherId    Int
  date         DateTime
  status       String
  observations String?

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
}

//////////////////////////////////////////////////
// INCIDENTS
//////////////////////////////////////////////////
model Incident {
  id          Int      @id @default(autoincrement())
  studentId   Int
  date        DateTime
  type        String?
  description String?
  reportedBy  Int?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [reportedBy], references: [id])
}

//////////////////////////////////////////////////
// PLANNINGS
//////////////////////////////////////////////////
model Planning {
  id          Int       @id @default(autoincrement())
  teacherId   Int
  subjectId   Int
  sectionId   Int
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  fileUrl     String?
  createdAt   DateTime  @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////
// FORMATS
//////////////////////////////////////////////////
model Format {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  fileUrl     String
  uploadedBy  Int?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [uploadedBy], references: [id])
}
